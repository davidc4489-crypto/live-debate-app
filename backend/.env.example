PORT=3001

# Fuseau utilisé pour formater les dates dans les notifications de planification
# (le serveur tourne en UTC : sans cette variable, les heures annoncées sont fausses)
APP_TIMEZONE=Europe/Paris

# Limite de taille du corps des requêtes JSON
BODY_LIMIT=100kb

# Durée du cache de validation des jetons (évite un aller-retour Supabase par action)
AUTH_CACHE_TTL_MS=60000

# Origines frontend autorisées pour les liens de confirmation email (virgule = plusieurs)
# Local + production Vercel
FRONTEND_URL=http://localhost:3000,https://live-debate-app.vercel.app

# Supabase (URL sans /rest/v1)
# ⚠️ NE JAMAIS committer de vraies clés ici : ce fichier est versionné.
# Les valeurs se trouvent dans Supabase → Settings → API.
SUPABASE_URL=https://<votre-projet>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# ⚠️ Clé d'administration : contourne toutes les RLS. Backend uniquement,
# jamais côté client, jamais dans un fichier versionné.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# PostgreSQL direct (optionnel — migrations locales)
DATABASE_URL=postgresql://postgres:<password>@db.<votre-projet>.supabase.co:5432/postgres

# --- Modération (microservice Python + modèles Hugging Face) ---------------
MODERATION_SERVICE_URL=http://localhost:8000
MODERATION_TIMEOUT_MS=300
# Timeout de l'analyse qualitative (hors chemin critique, peut être plus long)
MODERATION_ANALYZE_TIMEOUT_MS=500
# Si le service est indisponible : allow (filtre lexical seul) | warn (avertit systématiquement)
MODERATION_FALLBACK_ON_DOWN=warn
MODERATION_CACHE_TTL_MS=60000

# Circuit breaker : après N échecs consécutifs, on cesse d'appeler le service
# pendant X ms (évite de payer le timeout sur chaque message quand il est down).
MODERATION_CIRCUIT_FAILURES=3
MODERATION_CIRCUIT_RESET_MS=15000

# --- Garde anti-spam (avant tout appel modèle) -----------------------------
MODERATION_RATE_WINDOW_MS=10000
MODERATION_RATE_MAX=5
MODERATION_DUPLICATE_WINDOW_MS=60000
MODERATION_DUPLICATE_MAX=2
