{
  "name": "live-debate-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS backend for live debate MVP",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "seed": "node scripts/seed-debates.mjs",
    "migrate:profiles": "node scripts/apply-profile-migration.mjs",
    "migrate": "node scripts/apply-migration.mjs",
    "test:moderation": "node scripts/test-moderation.mjs",
    "test:moderation:live": "node scripts/test-moderation.mjs --live",
    "test:rooms": "npm run build && node scripts/test-rooms.mjs",
    "test": "npm run test:moderation && npm run test:rooms"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/platform-socket.io": "^10.4.8",
    "@nestjs/websockets": "^10.4.8",
    "@supabase/supabase-js": "^2.105.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
