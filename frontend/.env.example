NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Origine publique du site. À renseigner en production : elle alimente les
# métadonnées de partage (OpenGraph), robots.txt et le sitemap. Sans elle, un
# lien partagé pointerait vers localhost.
NEXT_PUBLIC_APP_URL=https://live-debate-app.vercel.app

# Fuseau d'affichage des dates de débat (doit correspondre à APP_TIMEZONE côté backend)
NEXT_PUBLIC_APP_TIMEZONE=Europe/Paris
