# --- Seuils de décision ----------------------------------------------------
MOD_THRESHOLD_BLOCK=0.75
MOD_THRESHOLD_WARN=0.50
MOD_INSULT_BLOCK=0.80
MOD_THREAT_BLOCK=0.70
MOD_HATE_BLOCK=0.70
MOD_SEVERE_BLOCK=0.50
MOD_SEXUAL_BLOCK=0.85
MOD_COMBINED_WARN=0.45

# --- Backend ---------------------------------------------------------------
# auto      : modèles Hugging Face si disponibles, repli lexique sinon (défaut)
# local     : modèles obligatoires (échec explicite si le chargement rate)
# heuristic : lexique seul, aucun téléchargement (CI, dev, petite machine)
MOD_BACKEND=auto
MOD_DEVICE=auto
MOD_WARMUP=true
MOD_CACHE_SIZE=4096
MOD_MAX_BATCH=32

# --- Modèles ---------------------------------------------------------------
# Principal : Detoxify multilingue (fr, en, es, it, pt, ru, tr) — 7 catégories
MOD_ENABLE_DETOXIFY=true
MOD_DETOXIFY_CHECKPOINT=multilingual

# Second avis léger sur la toxicité globale (distilbert 540 Mo)
MOD_ENABLE_SECONDARY=false
MOD_MULTILINGUAL_MODEL=citizenlab/distilbert-base-multilingual-cased-toxicity

# Haine ciblée en français (optionnel, +700 Mo)
MOD_ENABLE_FRENCH_HATE=false
MOD_FRENCH_HATE_MODEL=Hate-speech-CNERG/dehatebert-mono-french

# Analyse de ton (optionnel)
MOD_ENABLE_SENTIMENT=false
MOD_SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

# Classification thématique zero-shot (optionnel)
MOD_ENABLE_ZEROSHOT=false
MOD_ZEROSHOT_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
MOD_DEBATE_TOPICS=Politique,Technologie,Sport,Philosophie,Société,Économie

# Token Hugging Face (quotas de téléchargement, modèles privés)
# HF_TOKEN=hf_xxx
